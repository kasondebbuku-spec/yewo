{
  "expo": {
    "name": "Yewo",
    "slug": "yewo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zm.yewo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "zm.yewo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yewo uses your location to find verified workers near you and to confirm job check-ins."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yewo needs your photos so workers can upload their NRC for verification.",
          "cameraPermission": "Yewo uses the camera so workers can photograph their NRC and take a selfie for verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E",
          "defaultChannel": "jobs"
        }
      ]
    ],
    "scheme": "yewo"
  }
}
